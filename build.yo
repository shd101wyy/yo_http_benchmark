build :: import("std/build");

// The module root is declared in `yo.toml` `[modules]`; `build.module` only
// NAMES it now (there is nothing to link here, so it is not even needed —
// kept out rather than kept as a no-op).
exe :: build.executable({
  name : "yo_http_benchmark",
  root : "./src/main.yo",
  optimize : build.Optimize.ReleaseFast
});

exe_mt :: build.executable({
  name : "yo_http_benchmark_mt",
  root : "./src/main_mt.yo",
  optimize : build.Optimize.ReleaseFast
});

lib :: build.static_library({ name : "yo_http_benchmark-lib", root : "./src/lib.yo" });

tests :: build.test({ name : "tests", root : "./tests/" });

run_exe :: build.run(exe);

docs :: build.doc({ name : "docs", root : "./src" });

install :: build.step("install", "Build all artifacts");
install.depend_on(exe);
install.depend_on(exe_mt);
install.depend_on(lib);

run_step :: build.step("run", "Run the application");
run_step.depend_on(run_exe);

test_step :: build.step("test", "Run unit tests");
test_step.depend_on(tests);

doc_step :: build.step("doc", "Generate documentation");
doc_step.depend_on(docs);
