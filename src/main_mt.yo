// Yo HTTP benchmark server — multi-threaded variant.
// Each worker thread creates its own SO_REUSEPORT socket; the kernel
// load-balances incoming connections across all threads.
IO_tcp :: import("std/sys/tcp");
{
  AF_INET,
  SOCK_STREAM,
  SOL_SOCKET,
  SO_REUSEADDR,
  SO_REUSEPORT,
  IPPROTO_TCP,
  TCP_NODELAY
} :: import("std/sys/socket");
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
{ Exception, IoExn } :: import("std/error");
{ printf } :: import("std/libc/stdio");

pragma(Pragma.AllowUnsafe);
{ ThreadPool, spawn, get_hardware_threads } :: import("std/thread");

PORT :: u16(3000);
BACKLOG :: i32(4096);
BUF_SIZE :: usize(4096);

RESPONSE :: "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 13\r\nConnection: keep-alive\r\n\r\nHello, World!";
RESPONSE_LEN :: usize(102);

handle_client :: (
  fn(fd : i32, io : Io, exn : Exception) ->
    Impl(Future(unit, IoExn))
)(
  io.async(e => {
    // Set TCP_NODELAY to disable Nagle's algorithm
    val := i32(1);
    val_ptr := &val;
    e.io.await(IO_tcp.setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, (*u8)(val_ptr), u32(4)), e.io);

    buf := (*u8)(malloc(BUF_SIZE).unwrap());

    done := false;
    while(runtime(!done), {
      n := e.io.await(IO_tcp.recv(fd, buf, BUF_SIZE, i32(0)), e.io);
      cond(
        (n <= i32(0)) => {
          done = true;
        },
        true => ()
      );
      cond(
        !done => {
          e.io.await(IO_tcp.send(fd, (*u8)(RESPONSE), RESPONSE_LEN, i32(0)), e.io);
        },
        true => ()
      );
    });

    free(.Some((*void)(buf)));
    e.io.await(IO_tcp.close(fd), e.io);
  })
);

// Server accept loop. Each call creates its own SO_REUSEPORT socket and
// never returns. Safe to run concurrently on multiple threads.
run_server :: (fn(io : Io) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        unsafe(printf("Server error\n"));
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : exn);

  raw_fd := io.await(IO_tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  cond(
    (raw_fd < i32(0)) => {
      unsafe(printf("Failed to create socket\n"));
      return(());
    },
    true => ()
  );

  // Set SO_REUSEADDR and SO_REUSEPORT
  reuse_val := i32(1);
  reuse_ptr := &reuse_val;
  io.await(IO_tcp.setsockopt(raw_fd, SOL_SOCKET, SO_REUSEADDR, (*u8)(reuse_ptr), u32(4)), io);
  io.await(IO_tcp.setsockopt(raw_fd, SOL_SOCKET, SO_REUSEPORT, (*u8)(reuse_ptr), u32(4)), io);

  saddr := IO_tcp.make_sockaddr_in_any(PORT);
  bind_result := io.await(IO_tcp.bind(raw_fd, saddr.buf, saddr.len), io);
  IO_tcp.free_sockaddr(saddr);
  cond(
    (bind_result < i32(0)) => {
      unsafe(printf("Failed to bind\n"));
      return(());
    },
    true => ()
  );

  listen_result := io.await(IO_tcp.listen(raw_fd, BACKLOG), io);
  cond(
    (listen_result < i32(0)) => {
      unsafe(printf("Failed to listen\n"));
      return(());
    },
    true => ()
  );

  addr_buf := (*u8)(malloc(usize(128)).unwrap());
  addr_len_ptr := (*u32)(malloc(usize(4)).unwrap());

  while(runtime(true), {
    addr_len_ptr.* = u32(128);
    client_fd := io.await(IO_tcp.accept(raw_fd, addr_buf, addr_len_ptr), io);
    cond(
      (client_fd >= i32(0)) => {
        task := handle_client(client_fd, io, exn);
        io.spawn(task, e);
      },
      true => ()
    );
  });
});

main :: (fn(io : Io) -> unit)({
  num_threads := get_hardware_threads();
  pool := ThreadPool.new(num_threads);
  unsafe(printf("Yo HTTP server (multi-threaded, %zu threads) listening on port 3000\n", num_threads));

  // Spawn N-1 workers; run the Nth on the main thread.
  i := usize(0);
  while(runtime(i < (num_threads - usize(1))), {
    spawn(pool, (worker_io : Io) => run_server(worker_io));
    i = (i + usize(1));
  });

  run_server(io);
});

export(main);
